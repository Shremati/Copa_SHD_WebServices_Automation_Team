                                    <com:DepartureAirport LocationCode="PTY"/>
                                    <com:ArrivalAirport LocationCode="LAX"/>
                                    <n1:MarketingAirline Code="CM"/>
                                </n1:FlightSegment>
                            </n1:OriginDestinationOption>
                            <n1:OriginDestinationOption>
                                <n1:FlightSegment DepartureDateTime="2023-01-22T00:54:00" ArrivalDateTime="2023-01-22T10:23:00" RPH="2" FlightNumber="303" ResBookDesigCode="Y" NumberInParty="2" Status="26" E_TicketEligibility="Eligible" DepartureDay="Fri">
                                    <com:DepartureAirport LocationCode="LAX"/>
                                    <com:ArrivalAirport LocationCode="PTY"/>
                                    <n1:MarketingAirline Code="CM"/>
                                </n1:FlightSegment>
                            </n1:OriginDestinationOption>
                        </n1:OriginDestinationOptions>
                    </n1:AirItinerary>
                    <n1:PriceInfo>
                        <n1:PTC_FareBreakdowns>
                            <n1:PTC_FareBreakdown>
                                <n1:PassengerTypeQuantity Code="ADT" Quantity="1"/>
                                <n1:FareBasisCodes>
                                    <n1:FareBasisCode FlightSegmentRPH="1">XY</n1:FareBasisCode>
                                    <n1:FareBasisCode FlightSegmentRPH="2">YZ</n1:FareBasisCode>
                                </n1:FareBasisCodes>
                                <n1:PassengerFare>
                                    <n1:BaseFare Amount="159.60" CurrencyCode="USD"/>
                                    <n1:Taxes>
                                        <n1:Tax TaxCode="AY" Amount="5.60"/>
                                        <n1:Tax TaxCode="XA" Amount="3.83"/>
