                                </n1:PassengerFare>
                                <n1:TravelerRefNumber RPH="1" SurnameRefNumber="1"/>
                            </n1:PTC_FareBreakdown>
                            <n1:PTC_FareBreakdown>
                                <n1:PassengerTypeQuantity Code="ADT" Quantity="1"/>
                                <n1:FareBasisCodes>
                                    <n1:FareBasisCode FlightSegmentRPH="1">XY</n1:FareBasisCode>
                                    <n1:FareBasisCode FlightSegmentRPH="2">YZ</n1:FareBasisCode>
                                </n1:FareBasisCodes>
                                <n1:PassengerFare>
                                    <n1:BaseFare Amount="159.60" CurrencyCode="USD"/>
                                    <n1:Taxes>
                                        <n1:Tax TaxCode="AY" Amount="5.60"/>
                                        <n1:Tax TaxCode="XA" Amount="3.83"/>
                                    </n1:Taxes>
                                    <n1:TotalFare Amount="177.30" CurrencyCode="USD"/>
