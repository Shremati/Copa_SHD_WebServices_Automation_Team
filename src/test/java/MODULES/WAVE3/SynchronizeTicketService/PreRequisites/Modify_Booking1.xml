<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:mod="http://www.eds.com/AirlineSOASchema/ModifyBooking/" xmlns:air="http://www.opentravel.org/OTA/2003/05/AirBookModifyRQ" xmlns:com="http://www.opentravel.org/OTA/2003/05/CommonTypes" xmlns:air1="http://www.opentravel.org/OTA/2003/05/AirCommonTypes">
    <soapenv:Header/>
    <soapenv:Body>
        <mod:modifyBooking>
            <air:OTA_AirBookModifyRQ Version="4.000">
                <air:POS>
                    <com:Source AirlineVendorID="CM"/>
                </air:POS>
                <!--Possible values for ModificationType:
                      Value   Action
                        1     CANCEL_BOOKING
                        3     MODIFY_NAME
                        4     REPLACE_NAME
                        5     OTHER
                        6     DIVIDE_PNR
                        7     REDUCE_PARTY-->
                <air:AirBookModifyRQ ModificationType="3">
                    <!--MODIFY_NAME-->
                    <!--Required data: The new name for the passenger.-->
                    <!--NOTE: To modify the name of an INF or the adult with a lap baby
                         we need to include both otherwise we will lose either the adult or the INF.-->
                    <air1:TravelerInfo>
                        <!--We can set the passenger type here as: ADT, CHD, INF-->
                        <air1:AirTraveler PassengerTypeCode="ADT">
                            <!--The new name-->
                            <air1:PersonName>
                                <com:GivenName>FOXXX</com:GivenName>
                                <com:Surname>MULDER</com:Surname>
                            </air1:PersonName>
                            <!--The passenger to update his/her name.-->
                            <air1:TravelerRefNumber RPH="1"/>
                        </air1:AirTraveler>
                    </air1:TravelerInfo>
                    <!--the booking to modify-->
                    <air1:BookingReferenceID Type="14" ID="A1UBOE"/>
                </air:AirBookModifyRQ>
                <!--we include the original reservation to check if both reservations(SHARES and this AirReservation) are in sync-->
                <air:AirReservation LastModified="2023-01-23T17:00:54Z" CreateDateTime="2023-01-23T16:59:00Z" xmlns:n1="http://www.opentravel.org/OTA/2003/05/AirCommonTypes">
