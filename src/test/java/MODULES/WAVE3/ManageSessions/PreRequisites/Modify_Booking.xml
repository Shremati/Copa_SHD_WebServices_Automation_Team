                            <air1:PersonName>
                                <com:GivenName>LISA</com:GivenName>
                                <com:Surname>SIMPSON</com:Surname>
                            </air1:PersonName>
                            <!--For passenger type CHD the age is mandatory-->
                            <air1:PassengerTypeQuantity Age="08"/>
                            <!--The passenger to update his/her name.-->
                            <air1:TravelerRefNumber RPH="3"/>
                        </air1:AirTraveler>
                    </air1:TravelerInfo>
                    <!--the booking to modify-->
                    <air1:BookingReferenceID Type="14" ID="AIN5SJ"/>
