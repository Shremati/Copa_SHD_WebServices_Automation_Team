                      Value   Action
                        1     CANCEL_BOOKING
                        3     MODIFY_NAME
                        4     REPLACE_NAME
                        5     OTHER
                        6     DIVIDE_PNR
                        8     REDUCE_PARTY-->
                <air:AirBookModifyRQ ModificationType="3">
                    <!--MODIFY_NAME-->
                    <!--Required data: The new name for the passenger.-->
                    <!--NOTE: To modify the name of an INF or the adult with a lap baby
                         we need to include both otherwise we will lose either the adult or the INF.-->
                    <air1:TravelerInfo>
                        <!--We can set the passenger type here as: ADT, CHD, INF-->
                        <air1:AirTraveler PassengerTypeCode="ADT">
                            <!--The new name-->
                            <air1:PersonName>
                                <com:GivenName>GIRLFRIEND</com:GivenName>
                                <com:Surname>ZIDANE</com:Surname>
                            </air1:PersonName>
                            <!--The passenger to update his/her name.-->
                            <air1:TravelerRefNumber RPH="1"/>
                        </air1:AirTraveler>
                        <air1:AirTraveler BirthDate="2009-01-01" PassengerTypeCode="INF">
                            <!--The new name-->
                            <air1:PersonName>
                                <com:GivenName>MINI</com:GivenName>
                                <com:Surname>ZIDANE</com:Surname>
                            </air1:PersonName>
                            <!--The passenger to update his/her name.-->
                            <air1:TravelerRefNumber RPH="2"/>
                        </air1:AirTraveler>
