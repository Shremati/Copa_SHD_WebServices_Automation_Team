                    </air1:AirItinerary>
                    <air1:PriceInfo>
                        <air1:PTC_FareBreakdowns>
                            <air1:PTC_FareBreakdown>
                                <air1:PassengerTypeQuantity Code="ADT" Quantity="1"/>
                                <air1:FareBasisCodes>
                                    <air1:FareBasisCode FlightSegmentRPH="1" NotValidBefore="2023-02-20" NotValidAfter="2023-02-20">Y</air1:FareBasisCode>
                                </air1:FareBasisCodes>
                                <air1:PassengerFare>
                                    <air1:BaseFare Amount="110.00" CurrencyCode="USD"/>
                                    <air1:Taxes>
                                        <air1:Tax TaxCode="AG" Amount="12.00"/>
                                        <air1:Tax TaxCode="CD" Amount="8.50"/>
                                        <air1:Tax TaxCode="XT" Amount="15.00"/>
                                    </air1:Taxes>
                                    <air1:TotalFare Amount="145.50" CurrencyCode="USD"/>
                                    <air1:UnstructuredFareCalc>SALUDOS END</air1:UnstructuredFareCalc>
                                </air1:PassengerFare>
                                <air1:TravelerRefNumber RPH="1" SurnameRefNumber="1"/>
                            </air1:PTC_FareBreakdown>
                            <air1:PTC_FareBreakdown>
                                <air1:PassengerTypeQuantity Code="ADT" Quantity="1"/>
                                <air1:FareBasisCodes>
                                    <air1:FareBasisCode FlightSegmentRPH="1" NotValidBefore="2023-02-20" NotValidAfter="2023-02-20">Y</air1:FareBasisCode>
                                </air1:FareBasisCodes>
                                <air1:PassengerFare>
                                    <air1:BaseFare Amount="110.00" CurrencyCode="USD"/>
                                    <air1:Taxes>
                                        <air1:Tax TaxCode="AG" Amount="12.00"/>
                                        <air1:Tax TaxCode="CD" Amount="8.50"/>
                                        <air1:Tax TaxCode="XT" Amount="15.00"/>
                                    </air1:Taxes>
                                    <air1:TotalFare Amount="145.50" CurrencyCode="USD"/>
                                    <air1:UnstructuredFareCalc>SALUDOS END</air1:UnstructuredFareCalc>
                                </air1:PassengerFare>
                                <air1:TravelerRefNumber RPH="2" SurnameRefNumber="2"/>
                            </air1:PTC_FareBreakdown>
                            <air1:PTC_FareBreakdown>
                                <air1:PassengerTypeQuantity Code="ADT" Quantity="1"/>
                                <air1:FareBasisCodes>
                                    <air1:FareBasisCode FlightSegmentRPH="1" NotValidBefore="2023-02-20" NotValidAfter="2023-02-20">Y</air1:FareBasisCode>
                                </air1:FareBasisCodes>
                                <air1:PassengerFare>
                                    <air1:BaseFare Amount="110.00" CurrencyCode="USD"/>
                                    <air1:Taxes>
                                        <air1:Tax TaxCode="AG" Amount="12.00"/>
                                        <air1:Tax TaxCode="CD" Amount="8.50"/>
                                        <air1:Tax TaxCode="XT" Amount="15.00"/>
                                    </air1:Taxes>
                                    <air1:TotalFare Amount="145.50" CurrencyCode="USD"/>
                                    <air1:UnstructuredFareCalc>SALUDOS END</air1:UnstructuredFareCalc>
                                </air1:PassengerFare>
                                <air1:TravelerRefNumber RPH="3" SurnameRefNumber="3"/>
                            </air1:PTC_FareBreakdown>
                        </air1:PTC_FareBreakdowns>
                        <air1:PriceRequestInformation PricingSource="Private">
                            <air1:NegotiatedFareCode>932045</air1:NegotiatedFareCode>
                        </air1:PriceRequestInformation>
                    </air1:PriceInfo>
                    <air1:TravelerInfo>
                        <air1:AirTraveler PassengerTypeCode="ADT">
                            <air1:PersonName>
                                <com:GivenName>ERIC</com:GivenName>
                                <com:Surname>CARTMAN</com:Surname>
                            </air1:PersonName>
                            <air1:Telephone LocationCode="LON" PhoneUseType="0" AreaCityCode="000" PhoneNumber=" "/>
                            <air1:TravelerRefNumber RPH="1" SurnameRefNumber="1"/>
                        </air1:AirTraveler>
                        <air1:AirTraveler PassengerTypeCode="ADT">
                            <air1:PersonName>
                                <com:GivenName>KYLE</com:GivenName>
                                <com:Surname>BROFLOVSKY</com:Surname>
                            </air1:PersonName>
                            <air1:TravelerRefNumber RPH="2" SurnameRefNumber="2"/>
                        </air1:AirTraveler>
                        <air1:AirTraveler PassengerTypeCode="ADT">
                            <air1:PersonName>
                                <com:GivenName>STAN</com:GivenName>
                                <com:Surname>MARSH</com:Surname>
                            </air1:PersonName>
                            <air1:TravelerRefNumber RPH="3" SurnameRefNumber="3"/>
                        </air1:AirTraveler>
                        <air1:SpecialReqDetails>
                            <air1:SpecialServiceRequests>
                                <air1:SpecialServiceRequest TravelerRefNumberRPHList="3" FlightRefNumberRPHList="1" SSRCode="PETC" ServiceQuantity="1" Status="11">
                                    <air1:Airline Code="CM"/>
                                    <air1:Text>LHRJFK0045K06NOV-1MARSH/STAN.GATO</air1:Text>
                                </air1:SpecialServiceRequest>
                            </air1:SpecialServiceRequests>
                            <air1:OtherServiceInformations>
                                <air1:OtherServiceInformation>
                                    <air1:Airline Code="CM"/>
                                    <air1:Text>INFORMACION DE OTROS SERVICIOS</air1:Text>
                                </air1:OtherServiceInformation>
                                <air1:OtherServiceInformation>
                                    <air1:Airline Code="CM"/>
                                    <air1:Text>OTRO SERVICIO</air1:Text>
                                </air1:OtherServiceInformation>
                            </air1:OtherServiceInformations>
                            <air1:Remarks>
                                <air1:Remark>SOUTH PARK</air1:Remark>
                                <air1:Remark>REMARK ONE</air1:Remark>
                                <air1:Remark>REMARK TWO</air1:Remark>
                                <air1:Remark>REMARK THREE</air1:Remark>
                                <air1:Remark>FOR MODIFY TRAVELER INFO TEST</air1:Remark>
                                <air1:Remark>05 REMARKS ADDED BY LHR SU X1 26SEP 0137Z D12B05</air1:Remark>
                            </air1:Remarks>
                        </air1:SpecialReqDetails>
                    </air1:TravelerInfo>
                    <air1:Ticketing TicketingStatus="3"/>
                    <air1:BookingReferenceID Type="14" ID="AKDDSX"/>
                    <air1:BookingReferenceID Type="0" ID_Context="IATA" ID="91112221"/>
                </air:AirReservation>
            </air:OTA_AirBookModifyRQ>
