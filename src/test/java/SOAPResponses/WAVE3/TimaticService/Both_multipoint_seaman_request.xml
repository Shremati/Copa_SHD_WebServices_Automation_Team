              <ns3:Country Code="BG">BULGARIA</ns3:Country>
              <ns5:DestinationCountryInformation SubTitle="PASSPORT">
                <Paragraph Name="1">
                  <Text>PASSPORTS AND OTHER DOCUMENTS ACCEPTED FOR ENTRY ISSUED TO NATIONALS OF FRANCE MUST BE VALID FOR THE PERIOD OF INTENDED STAY.</Text>
                </Paragraph>
                <Paragraph Name="2">
                  <Text>PASSPORTS AND OTHER DOCUMENTS ACCEPTED FOR ENTRY ISSUED TO RESIDENTS OF BULGARIA MUST BE VALID ON ARRIVAL.</Text>
                </Paragraph>
              </ns5:DestinationCountryInformation>
              <ns5:DestinationCountryInformation SubTitle="PASSPORT EXEMPTIONS">
                <Paragraph Name="1">
                  <Text>PASSENGERS WITH A SEAMAN BOOK.</Text>
                </Paragraph>
              </ns5:DestinationCountryInformation>
              <ns5:DestinationCountryInformation SubTitle="VISA">
                <Paragraph Name="1">
                  <Text>FOR MERCHANT SEAMEN ARRIVING BY AIR, A PRIOR TELEX INFORMATION MUST BE SENT TO THE STATION MANAGER OF THE TRANSPORTING AIRLINE.</Text>
                </Paragraph>
                <Paragraph Name="2">
                  <Text>WARNING: MERCHANT SEAMEN MUST TRAVEL ON DUTY AND HAVE A LETTER OF EMPLOYMENT OR A LETTER OF GUARANTEE ISSUED BY THE SHIPPING COMPANY.</Text>
                </Paragraph>
              </ns5:DestinationCountryInformation>
              <ns5:DestinationCountryInformation SubTitle="HEALTH"/>
            </ns5:DestinationLocation>
            <ns5:DestinationLocation PassportRequired="true" PassportType="SEAMAN">
              <ns3:Country Code="PT">PORTUGAL</ns3:Country>
              <ns5:DestinationCountryInformation SubTitle="PASSPORT">
                <Paragraph Name="1">
                  <Text>PASSPORTS AND OTHER DOCUMENTS ACCEPTED FOR ENTRY MUST BE VALID FOR A MINIMUM OF 3 MONTHS BEYOND THE PERIOD OF INTENDED STAY.</Text>
                </Paragraph>
                <Paragraph Name="2">
                  <Text>NATIONALS OF FRANCE ARE ALLOWED TO ENTER WITH AN EXPIRED PASSPORT. THE PASSPORT IS ACCEPTED WHEN EXPIRED FOR A MAXIMUM OF 5 YEARS.</Text>
                </Paragraph>
              </ns5:DestinationCountryInformation>
              <ns5:DestinationCountryInformation SubTitle="VISA">
                <Paragraph Name="1">
                  <Text>WARNING: MERCHANT SEAMEN MUST TRAVEL ON DUTY AND HAVE A LETTER OF EMPLOYMENT OR A LETTER OF GUARANTEE ISSUED BY THE SHIPPING COMPANY.</Text>
