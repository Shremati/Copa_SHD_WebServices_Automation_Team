                <Paragraph Name="1">
                  <Text>PASSPORTS AND OTHER DOCUMENTS ACCEPTED FOR ENTRY MUST BE VALID FOR THE PERIOD OF INTENDED STAY.</Text>
                </Paragraph>
                <Paragraph Name="2">
                  <Text>BURKINA FASO HAS NO SEA HARBOR. THEREFORE MERCHANT SEAMEN CANNOT BE TRAVELING ON DUTY TO BURKINA FASO.</Text>
                </Paragraph>
              </ns5:DestinationCountryInformation>
              <ns5:DestinationCountryInformation SubTitle="HEALTH"/>
              <ns5:DestinationCountryInformation SubTitle="EXEMPT FROM YELLOW FEVER VACCINATION">
                <Paragraph Name="1">
                  <Text>CHILDREN UNDER 9 MONTHS OF AGE.</Text>
                </Paragraph>
